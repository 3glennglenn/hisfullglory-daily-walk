---
import { appUrl, shopUrl } from "../config";
import { resources } from "../data/resources";
import Base from "../layouts/Base.astro";
---

<Base
  title="Shop"
  description="Shop study Bibles chosen to support your reading, grouped by study goal. Each one links to the HisFullGlory shop."
>
  <section class="section">
    <div class="wrap">
      <h1>Shop</h1>
      <p class="lede">
        Study Bibles chosen to support your reading. Each one opens in our shop.
      </p>
      <div class="actions top-action">
        <a class="button" href={shopUrl}>Visit the shop</a>
      </div>

      <ul class="grid list">
        {
          resources.map((resource) => (
            <li class="card">
              <img
                class="cover"
                src={`${resource.image.src}&width=640`}
                srcset={`${resource.image.src}&width=320 320w, ${resource.image.src}&width=640 640w, ${resource.image.src}&width=960 960w`}
                sizes="(min-width: 52rem) 18rem, 90vw"
                width={resource.image.width}
                height={resource.image.height}
                alt={resource.image.alt}
                loading="lazy"
                decoding="async"
              />
              <p class="eyebrow">{resource.goal}</p>
              <h2>{resource.title}</h2>
              <p>{resource.summary}</p>
              <a class="button secondary" href={`${shopUrl}/products/${resource.handle}`}>
                View in the shop
              </a>
            </li>
          ))
        }
      </ul>

      <p class="muted small note">
        Prices and availability are shown in the shop. The shop currently ships
        within the United States.
      </p>

      <div class="card reading">
        <h2>Reading comes first</h2>
        <p>
          A study Bible can help you read with more understanding. You can also
          start today with the Bible on this site or in the app.
        </p>
        <div class="actions">
          <a class="button" href={appUrl}>Open the app</a>
          <a class="button secondary" href="/bible">Explore the Bible</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .lede {
    margin-top: 16px;
  }
  .top-action {
    margin-top: 24px;
  }
  .list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .list .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* The covers differ in shape, so each sits whole inside the same frame. */
  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    margin-bottom: 16px;
    border-radius: 12px;
    background: var(--bg);
  }
  .list h2 {
    font-size: var(--text-title);
  }
  .list .button {
    margin-top: auto;
  }
  .list p:not(.eyebrow) {
    margin-bottom: 18px;
  }
  .note {
    margin-top: 16px;
  }
  .reading {
    margin-top: 40px;
    max-width: 42rem;
    background: var(--surface-2);
  }
  .reading .actions {
    margin-top: 16px;
  }
</style>
