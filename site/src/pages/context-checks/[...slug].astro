---
// /context-checks and /context-checks/<slug>: a well-known verse put back into its
// surroundings. Neither exists until at least one check is approved.
import Breadcrumb from "../../components/Breadcrumb.astro";
import DraftBanner from "../../components/DraftBanner.astro";
import EditorialNote from "../../components/EditorialNote.astro";
import { appUrl, shopUrl } from "../../config";
import Base from "../../layouts/Base.astro";
import { blocks } from "../../lib/ai";
import {
  arguedHeading,
  checkParts,
  publishedChecks,
  refHref,
  refLabel,
  storyStatuses,
  verses,
  withVoices,
  type ContextCheck,
} from "../../lib/content";

export function getStaticPaths() {
  const checks = publishedChecks();
  if (!checks.length) return [];
  return [
    { params: { slug: undefined }, props: { checks } },
    ...checks.map((item) => ({ params: { slug: item.slug }, props: { checks, item } })),
  ];
}

interface Props {
  checks: ContextCheck[];
  item?: ContextCheck;
}

const { checks, item } = Astro.props;
const label = item && refLabel(item.verse);
// Voices quoted inside "Who has argued over it" are not repeated as cards.
const cards = item?.voices.filter((voice) => !voice.id) ?? [];
---

{
  item ? (
    <Base title={`${label} in context`} description={item.hook} noindex={item.review !== "approved"}>
      <section class="section">
        <div class="wrap prose">
          <Breadcrumb trail={[{ label: "Context checks", href: "/context-checks" }]} current={label!} />
          {item.review === "draft" && <DraftBanner />}
          <p class="eyebrow">Context check</p>
          <h1>{label} in context</h1>
          <p class="lede">{item.hook}</p>

          <blockquote class="card verse" data-layer="scripture">
            {verses(item.verse).map((verse) => (
              <p>
                <sup>{verse.number}</sup>
                {" "}
                {verse.text}
              </p>
            ))}
            <p class="small muted">{label}, World English Bible</p>
          </blockquote>

          <section class="story" data-story={item.storyStatus}>
            <h2>The story around it</h2>
            {blocks(item.story).map((block) =>
              "list" in block ? (
                <ul>
                  {block.list.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              ) : (
                <p>{block.paragraph}</p>
              ),
            )}
            <p class="small muted status">{storyStatuses[item.storyStatus]}</p>
          </section>

          {
            cards.length > 0 && (
              <section class="voices" data-layer="voices">
                <h2>What others have said</h2>
                {cards.map((voice) => (
                  <figure class="card voice">
                    <blockquote>{voice.words}</blockquote>
                    <figcaption class="small muted">
                      {voice.name}, {voice.about}.{" "}
                      <a href={voice.source.url} rel="noopener">
                        Source
                      </a>
                    </figcaption>
                  </figure>
                ))}
              </section>
            )
          }

          {
            checkParts.map(([name, heading]) => (
              <>
                <section class="part" data-part={name}>
                  <h2>{heading}</h2>
                  {blocks(item[name]).map((block) =>
                    "list" in block ? (
                      <ul>
                        {block.list.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    ) : (
                      <p>{block.paragraph}</p>
                    ),
                  )}
                </section>
                {name === "readings" && item.argued && (
                  <section class="part argued" data-part="argued">
                    <h2>{arguedHeading}</h2>
                    {blocks(item.argued).map((block) => (
                      <p>
                        {withVoices("list" in block ? block.list.join(" ") : block.paragraph, item.voices).map((piece) =>
                          typeof piece === "string" ? piece : <q cite={piece.source.url}>{piece.words}</q>,
                        )}
                      </p>
                    ))}
                    <p class="small muted status">{storyStatuses.history}</p>
                  </section>
                )}
              </>
            ))
          }

          <div class="card sources" data-layer="sourced">
            <h2>Why we say this</h2>
            <p class="small muted">Bible passages this page rests on, in the World English Bible:</p>
            <ul>
              {item.basis.map((ref) => (
                <li>
                  <a href={refHref(ref)}>{refLabel(ref)}</a>
                </li>
              ))}
            </ul>
            {item.sources.length > 0 && (
              <>
                <p class="small muted">Sources outside the Bible:</p>
                <ul>
                  {item.sources.map((source) => (
                    <li>
                      <a href={source.url} rel="noopener">
                        {source.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            <p class="small muted dispute">
              Do you know a source that says otherwise, or adds to this?{" "}
              <a href={`${shopUrl}/pages/contact`}>Send it to us</a> and we will
              look at it.
            </p>
          </div>

          <div class="actions">
            <a class="button" href={`${appUrl}/bible/${item.verse.book}/${item.verse.chapter}`}>
              Study this passage in the app
            </a>
            <a class="button secondary" href={refHref(item.verse)}>
              Read the whole chapter
            </a>
          </div>

          <EditorialNote review={item.review} drafted={item.drafted} />
        </div>
      </section>
    </Base>
  ) : (
    <Base
      title="Context checks"
      description="Well-known Bible verses put back where they stand: who is speaking, to whom, and what is said around them."
      noindex={checks.some((entry) => entry.review !== "approved")}
    >
      <section class="section">
        <div class="wrap">
          <h1>Context checks</h1>
          <p class="lede">
            Verses many people know by heart, put back where they stand: who
            is speaking, to whom, and what is said around them.
          </p>
          <ul class="grid list">
            {checks.map((entry) => (
              <li class="card">
                <h2>
                  <a href={`/context-checks/${entry.slug}`}>{refLabel(entry.verse)}</a>
                </h2>
                <p>{entry.hook}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </Base>
  )
}

<style>
  .eyebrow {
    margin-bottom: 4px;
  }
  .lede {
    margin-top: 16px;
  }
  .verse {
    margin: 28px 0 0;
    font-size: 1.12rem;
    line-height: 1.8;
  }
  .verse p {
    margin: 0;
  }
  .verse p + p {
    margin-top: 10px;
  }
  .verse sup {
    font-size: 0.7em;
    font-weight: 600;
    color: var(--muted);
  }
  .story {
    margin-top: 32px;
  }
  .story h2 {
    margin-bottom: 8px;
  }
  .story .status {
    margin-top: 12px;
    padding-left: 12px;
    border-left: 3px solid var(--border);
  }
  .dispute {
    margin-top: 14px;
  }
  .voices {
    margin-top: 32px;
  }
  .voices h2 {
    margin-bottom: 12px;
  }
  .voice {
    margin: 0;
  }
  .voice + .voice {
    margin-top: 12px;
  }
  .voice blockquote {
    margin: 0 0 10px;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .voice blockquote::before {
    content: "\201C";
  }
  .voice blockquote::after {
    content: "\201D";
  }
  .part {
    margin-top: 32px;
  }
  .part h2 {
    margin-bottom: 8px;
  }
  .argued q {
    quotes: "\201C" "\201D" "\2018" "\2019";
  }
  .argued .status {
    margin-top: 12px;
    padding-left: 12px;
    border-left: 3px solid var(--border);
  }
  .sources {
    margin-top: 40px;
  }
  .sources h2 {
    margin-bottom: 8px;
  }
  .sources ul {
    margin: 10px 0 0;
    padding-left: 1.2rem;
  }
  .sources li + li {
    margin-top: 8px;
  }
  .list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .list h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
  }
  .list p {
    margin-bottom: 0;
  }
</style>
