---
// /context-checks and /context-checks/<slug>: a well-known verse put back into its
// surroundings. Neither exists until at least one check is published (approved, or with
// context written by an AI model, which the page says; src/lib/content.ts).
// Phase 01.1 (UI-SPEC W3, W5; founder decisions D-06, D-13): a page says first how far it was
// checked (the labelled AI note), then tells its story calmly, with one way into the app.
import AiBadge from "../../components/AiBadge.astro";
import AiUnreviewedNote from "../../components/AiUnreviewedNote.astro";
import Bookcase from "../../components/Bookcase.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Cover from "../../components/Cover.astro";
import DraftBanner from "../../components/DraftBanner.astro";
import EditorialNote from "../../components/EditorialNote.astro";
import ShareLinks from "../../components/ShareLinks.astro";
import SponsorBlock from "../../components/SponsorBlock.astro";
import { appUrl, shopUrl } from "../../config";
import Base from "../../layouts/Base.astro";
import { blocks } from "../../lib/ai";
import {
  aiUnreviewedCardLabel,
  arguedHeading,
  checkParts,
  featuredChecks,
  publishedChecks,
  refHref,
  refLabel,
  splitHook,
  storyStatuses,
  withVoices,
  type ContextCheck,
} from "../../lib/content";

export function getStaticPaths() {
  const checks = publishedChecks();
  if (!checks.length) return [];
  return [
    { params: { slug: undefined }, props: { checks } },
    ...checks.map((item) => ({ params: { slug: item.slug }, props: { checks, item } })),
  ];
}

interface Props {
  checks: ContextCheck[];
  item?: ContextCheck;
}

const { checks, item } = Astro.props;
const label = item && refLabel(item.verse);
// Voices quoted inside "Who has argued over it" are not repeated as cards.
const cards = item?.voices.filter((voice) => !voice.id) ?? [];
// The index lists every published check, newest first (D-06).
const newestFirst = featuredChecks();
---

{
  item ? (
    <Base title={`${label} in context`} description={item.hook} noindex={item.review === "draft"}>
      <section class="section">
        <div class="wrap prose">
          <Breadcrumb trail={[{ label: "Context checks", href: "/context-checks" }]} current={label!} />
          {item.review === "draft" && <DraftBanner />}
          {item.review === "ai-unreviewed" && <AiUnreviewedNote />}
          <h1>{label} in context</h1>
          <p class="lede">{item.hook}</p>

          <div class="verse-block">
            <Cover item={item} mode="verse" />
          </div>

          <section class="story" data-story={item.storyStatus}>
            <h2>The story around it</h2>
            {blocks(item.story).map((block) =>
              "list" in block ? (
                <ul>
                  {block.list.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              ) : (
                <p>{block.paragraph}</p>
              ),
            )}
            <p class="status">{storyStatuses[item.storyStatus]}</p>
          </section>

          {
            cards.length > 0 && (
              <section class="voices" data-layer="voices">
                <h2>What others have said</h2>
                {cards.map((voice) => (
                  <figure class="card voice">
                    <blockquote>{voice.words}</blockquote>
                    <figcaption>
                      {voice.name}, {voice.about}.{" "}
                      <a href={voice.source.url} rel="noopener">
                        Source
                      </a>
                    </figcaption>
                  </figure>
                ))}
              </section>
            )
          }

          {
            checkParts.map(([name, heading]) => (
              <>
                <section class="part" data-part={name}>
                  <h2>{heading}</h2>
                  {blocks(item[name]).map((block) =>
                    "list" in block ? (
                      <ul>
                        {block.list.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    ) : (
                      <p>{block.paragraph}</p>
                    ),
                  )}
                </section>
                {name === "readings" && item.argued && (
                  <section class="part argued" data-part="argued">
                    <h2>{arguedHeading}</h2>
                    {blocks(item.argued).map((block) => (
                      <p>
                        {withVoices("list" in block ? block.list.join(" ") : block.paragraph, item.voices).map((piece) =>
                          typeof piece === "string" ? piece : <q cite={piece.source.url}>{piece.words}</q>,
                        )}
                      </p>
                    ))}
                    <p class="status">{storyStatuses.history}</p>
                  </section>
                )}
              </>
            ))
          }

          <div class="card sources" data-layer="sourced">
            <h2>Why we say this</h2>
            <p class="note-line">Bible passages this page rests on, in the World English Bible:</p>
            <ul>
              {item.basis.map((ref) => (
                <li>
                  <a href={refHref(ref)}>{refLabel(ref)}</a>
                </li>
              ))}
            </ul>
            {item.sources.length > 0 && (
              <>
                <p class="note-line">Sources outside the Bible:</p>
                <ul>
                  {item.sources.map((source) => (
                    <li>
                      <a href={source.url} rel="noopener">
                        {source.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            <p class="note-line dispute">
              Do you know a source that says otherwise, or adds to this?{" "}
              <a href={`${shopUrl}/pages/contact`}>Send it to us</a> and we will
              look at it.
            </p>
          </div>

          <div class="actions">
            <a class="button" href={`${appUrl}/bible/${item.verse.book}/${item.verse.chapter}`}>
              Study this passage in the app
            </a>
            <a class="button secondary" href={refHref(item.verse)}>
              Read the whole chapter
            </a>
          </div>

          <ShareLinks text={item.hook} />

          <EditorialNote review={item.review} drafted={item.drafted} />
        </div>
      </section>
      <SponsorBlock place="site-context-check-end" />
    </Base>
  ) : (
    <Base
      title="Context checks"
      description="Well-known Bible verses put back where they stand: who is speaking, to whom, and what is said around them."
      noindex={checks.some((entry) => entry.review === "draft")}
    >
      <section class="section index">
        <div class="wrap">
          <h1>Context checks</h1>
          <p class="lede">
            Verses many people know by heart, put back where they stand: who
            is speaking, to whom, and what is said around them.
          </p>
          <div class="case">
            <Bookcase checks={newestFirst} />
          </div>
          <ul class="list">
            {newestFirst.map((entry) => (
              <li>
                <a class="row" href={`/context-checks/${entry.slug}`}>
                  <span class="row-text">
                    <span class="row-ref">{refLabel(entry.verse)}</span>
                    <span class="row-hook">{splitHook(entry.hook).first}</span>
                    {entry.review === "ai-unreviewed" && (
                      <span class="row-ai">
                        <AiBadge />
                        <span>{aiUnreviewedCardLabel}</span>
                      </span>
                    )}
                  </span>
                  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                    <path d="m7.5 4 6 6-6 6"></path>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </Base>
  )
}

<style>
  /* A context-check page reads in one 34em column of Body 17/27 (UI-SPEC 6.2, W3). */
  .prose {
    max-width: 34em;
  }
  .lede {
    margin-top: var(--space-4);
    font-size: var(--text-title);
    line-height: 1.5;
    color: var(--muted);
  }
  .verse-block {
    margin-top: var(--space-6);
  }
  .story,
  .voices,
  .part {
    margin-top: var(--space-7);
  }
  .story h2,
  .part h2 {
    margin-bottom: var(--space-2);
  }
  .voices h2 {
    margin-bottom: var(--space-3);
  }
  .status {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-3);
    border-left: 3px solid var(--line);
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  /* Voices are sourced quotations: the sourced treatment (a block on --surface, 1px --line), in
     the interface face, never the Scripture face. */
  .voice {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    box-shadow: none;
  }
  .voice + .voice {
    margin-top: var(--space-3);
  }
  .voice blockquote {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .voice blockquote::before {
    content: "\201C";
  }
  .voice blockquote::after {
    content: "\201D";
  }
  .voice figcaption,
  .note-line {
    margin: 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  .argued q {
    quotes: "\201C" "\201D" "\2018" "\2019";
  }
  .sources {
    margin-top: var(--space-8);
    padding: var(--space-4) var(--space-5);
    box-shadow: none;
  }
  .sources h2 {
    margin-bottom: var(--space-2);
  }
  .sources ul {
    margin: var(--space-3) 0 0;
    padding-left: 1.2em;
  }
  .sources li + li {
    margin-top: var(--space-2);
  }
  .dispute {
    margin-top: var(--space-4);
  }

  /* The index: the bookcase, then the list as rows (UI-SPEC W5, A8). */
  .index .lede {
    max-width: 34em;
  }
  .case {
    margin-top: var(--space-6);
  }
  .list {
    max-width: 40rem;
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .list li + li {
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 52px;
    padding: var(--space-3) var(--space-5);
    color: var(--ink);
    text-decoration: none;
  }
  .row:hover {
    background: var(--surface-2);
  }
  /* The list clips its corners, so the focus ring goes inside the row. */
  .row:focus-visible {
    outline-offset: -3px;
  }
  .row-text {
    display: grid;
    gap: var(--space-1);
  }
  .row-ref {
    font-weight: 600;
  }
  .row-hook {
    color: var(--muted);
  }
  .row-ai {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--ai);
  }
  .row svg {
    flex: none;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Lamplight (direction B, plan 16): each check is one of B's raised cards: the raised surface, the radius of the design
     system, the reference in the italic serif in --link, the hook in --ink and "Read the story" as a salmon text link. The
     whole card is still the one link, so its name is what it was; the words "Read the story" are drawn by the CSS. */
  :global(:root[data-mode="lamplight"]) .list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    background: none;
    border-radius: 0;
    overflow: visible;
  }
  :global(:root[data-mode="lamplight"]) .list li + li {
    border-top: 0;
  }
  :global(:root[data-mode="lamplight"]) .list .row {
    align-items: flex-start;
    padding: var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-lg);
  }
  :global(:root[data-mode="lamplight"]) .list .row:hover {
    background: var(--surface-2);
  }
  :global(:root[data-mode="lamplight"]) .list .row:focus-visible {
    outline-offset: 3px;
  }
  :global(:root[data-mode="lamplight"]) .list .row-ref {
    font-family: var(--font-scripture);
    font-style: italic;
    font-size: var(--text-title);
    font-weight: 400;
    line-height: 1.3;
    color: var(--link);
  }
  :global(:root[data-mode="lamplight"]) .list .row-hook {
    color: var(--ink);
  }
  :global(:root[data-mode="lamplight"]) .list .row-text::after {
    content: "Read the story";
    margin-top: var(--space-1);
    font-weight: 600;
    color: var(--link);
  }
  :global(:root[data-mode="lamplight"]) .list .row svg {
    display: none;
  }
  /* On a wide screen the overview's cards stand in columns, as in B. */
  @media (min-width: 900px) {
    :global(:root[data-mode="lamplight"]) .list {
      max-width: none;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    }
  }
</style>
