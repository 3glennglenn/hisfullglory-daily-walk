---
// Home, following docs/WEBSITE_PLAN.md, section 4.1. The newest published context check opens it
// on the cover, AI-written ones included and labelled (UI-SPEC W1, founder decision D-06).
import { launchTopics } from "../../../src/topics/graph.ts";
import { appUrl } from "../config";
import { appFeatures } from "../data/app";
import Cover from "../components/Cover.astro";
import Base from "../layouts/Base.astro";
import { featuredChecks, publishedTopics, refLabel } from "../lib/content";

const steps = [
  { title: "Read", text: "Open any chapter of the Bible in the World English Bible." },
  {
    title: "Understand",
    text: "See context that names its sources, so you know where it comes from.",
  },
  {
    title: "Discuss",
    text: "Bring a question to a topic or a Circle in the app and hear from others.",
  },
  {
    title: "Grow",
    text: "Return each day to Scripture, reflection and prayer, and trust God with the growth.",
  },
];

const promises = [
  "Scripture comes first. The text is the World English Bible, a public-domain translation.",
  "Context notes name their sources and carry a label that says how far they have been reviewed.",
  "Where we show an AI explanation, it is labelled as AI and kept apart from Scripture and from sourced notes.",
  "Community voices are labelled as community. Popularity does not make something true.",
  "Your journal and private prayers stay on your own device.",
  "The community has rules, reporting and moderation.",
];

// A card opens the topic page on this site once that page is approved, and the topic in
// the app until then.
// The newest published check leads the page, AI-written ones included (D-06); with none
// published the page keeps its opening h1 and lede, without a cover.
const newest = featuredChecks()[0];
const onSite = new Set(publishedTopics().map((topic) => topic.id));
const topicHref = (id: string) =>
  onSite.has(id) ? `/topics/${id}` : `${appUrl}/community/${id}`;
---

<Base>
  {
    newest ? (
      <section class="hero">
        <div class="wrap hero-cover">
          <Cover item={newest} />
          <a class="row-link" href="/context-checks">
            All context checks
          </a>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="wrap">
          <h1>Study the Bible together.</h1>
          <p class="lede">
            Read Scripture, understand its context, and talk it through with others.
          </p>
          <div class="actions">
            <a class="button" href={appUrl}>Open the app</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section band">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="grid steps">
        {
          steps.map((step, i) => (
            <li class="card">
              <p class="eyebrow">Step {i + 1}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Inside the app <span class="pill">Beta</span></h2>
      <ul class="grid plain">
        {
          appFeatures.map((feature) => (
            <li class="card">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="button" href={appUrl}>Open the app</a>
        <a class="button secondary" href="/beta">About the beta</a>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2>What you can count on</h2>
      <ul class="promises">
        {promises.map((promise) => <li>{promise}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Start here</h2>
      <p class="muted">Eight topics to begin with.</p>
      <ul class="topics plain">
        {
          launchTopics.map((topic) => (
            <li>
              <a href={topicHref(topic.id)}>{topic.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section band">
    <div class="wrap strip">
      <div>
        <h2>Resources</h2>
        <p class="muted">A small selection of study Bibles, chosen with care.</p>
      </div>
      <a class="button secondary" href="/resources">See the resources</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Join the beta</h2>
      <p class="lede">
        The app is open to try. You can begin as a guest, and your private
        writing stays on your device.
      </p>
      <div class="actions">
        <a class="button" href={appUrl}>Open the app</a>
        <a class="button secondary" href="/beta">How the beta works</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 32px 0;
  }
  .hero-cover {
    max-width: 40rem;
  }
  .row-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: var(--link);
    font-weight: 600;
    text-decoration: none;
  }
  h1 {
    max-width: 14ch;
  }
  h1 + .lede {
    margin-top: 16px;
  }
  .note {
    margin-top: 18px;
  }
  h2 {
    margin-bottom: 18px;
  }
  h2 + .muted,
  h2 + .lede {
    margin-top: -8px;
  }
  /* A section that continues the one above it, without a second top gap. */
  .follow {
    padding-top: 0;
  }
  .checks {
    margin-top: 16px;
  }
  .checks p {
    margin-bottom: 0;
  }
  .band {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .plain,
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .band .card {
    background: var(--bg);
  }
  .pill {
    display: inline-block;
    vertical-align: middle;
    margin-left: 8px;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .promises {
    margin: 0;
    padding-left: 1.2rem;
    max-width: 42rem;
  }
  .promises li + li {
    margin-top: 10px;
  }
  .topics {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    margin-top: 16px;
  }
  .topics a {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 8px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .topics a:hover {
    border-color: var(--focus);
  }
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .strip h2 {
    margin-bottom: 4px;
  }
  .strip .muted {
    margin: 0;
  }
</style>
