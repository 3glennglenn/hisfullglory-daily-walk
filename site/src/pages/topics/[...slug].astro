---
// /topics and /topics/<id>. Neither exists until at least one topic page is approved, so
// this is one route with a list of paths instead of two page files.
import Breadcrumb from "../../components/Breadcrumb.astro";
import DraftBanner from "../../components/DraftBanner.astro";
import EditorialNote from "../../components/EditorialNote.astro";
import ShareLinks from "../../components/ShareLinks.astro";
import { appUrl } from "../../config";
import Base from "../../layouts/Base.astro";
import {
  publishedArticles,
  publishedTopics,
  refHref,
  refLabel,
  type TopicPage,
} from "../../lib/content";

export function getStaticPaths() {
  const topics = publishedTopics();
  if (!topics.length) return [];
  return [
    { params: { slug: undefined }, props: { topics } },
    ...topics.map((topic) => ({ params: { slug: topic.id }, props: { topics, topic } })),
  ];
}

interface Props {
  topics: TopicPage[];
  topic?: TopicPage;
}

const { topics, topic } = Astro.props;
const articles = topic ? publishedArticles().filter((article) => article.topic === topic.id) : [];
---

{
  topic ? (
    <Base
      title={`${topic.label}: Bible passages`}
      description={`${topic.label}: ${topic.passages.length} Bible passages to start with, each with a one-line reason taken from the text itself.`}
      noindex={topic.review !== "approved"}
    >
      <section class="section">
        <div class="wrap prose">
          <Breadcrumb trail={[{ label: "Topics", href: "/topics" }]} current={topic.label} />
          {topic.review === "draft" && <DraftBanner />}
          <h1>{topic.label}</h1>
          <p class="lede">{topic.intro}</p>
          {topic.care && <p class="care">{topic.care}</p>}

          <h2>Passages to start with</h2>
          <ol class="passages">
            {topic.passages.map((passage) => (
              <li>
                <h3>
                  <a href={refHref(passage)}>{refLabel(passage)}</a>
                </h3>
                <p>{passage.reason}</p>
                <p class="more">
                  <a href={refHref(passage)}>Read {refLabel(passage)} in full</a>
                </p>
              </li>
            ))}
          </ol>
          <p class="foot">
            Each passage opens in the World English Bible on this site. The
            reason beside it quotes the passage itself.
          </p>

          {articles.length > 0 && (
            <>
              <h2>Read more</h2>
              <ul>
                {articles.map((article) => (
                  <li>
                    <a href={`/articles/${article.slug}`}>{article.title}</a>
                  </li>
                ))}
              </ul>
            </>
          )}

          <div class="actions">
            <a class="button" href={`${appUrl}/community/${topic.id}`}>
              Join the conversation
            </a>
            <a class="button secondary" href="/topics">
              All topics
            </a>
          </div>
          <p class="foot">
            The conversation is in the HisFullGlory app, a beta web app that
            opens in your browser.
          </p>

          <div class="circles">
            <h2>Talk it through in a Circle</h2>
            <p>
              A Circle is a small group in the app that walks through one
              subject together. You can start one or join one. Some Circles
              are private and ask you to apply first.
            </p>
            <a class="button secondary" href={`${appUrl}/community/circles`}>
              See Circles in the app
            </a>
          </div>

          <ShareLinks text={`${topic.label}: Bible passages`} />

          <EditorialNote review={topic.review} drafted={topic.drafted} />
        </div>
      </section>
    </Base>
  ) : (
    <Base
      title="Topics"
      description="Bible passages on the topics people ask about most, each with a short reason taken from the text itself."
      noindex={topics.some((entry) => entry.review !== "approved")}
    >
      <section class="section">
        <div class="wrap">
          <h1>Topics</h1>
          <p class="lede">
            Places to start reading, by topic. Each page lists a few passages
            and says in one line why each is there.
          </p>
          <ul class="grid list">
            {topics.map((entry) => (
              <li class="tile">
                <h2>
                  <a href={`/topics/${entry.id}`}>{entry.label}</a>
                </h2>
                <p class="muted">{entry.passages.length} passages</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </Base>
  )
}

<style>
  /* A topic page reads in one 34em column of Body 17/27 (UI-SPEC W4). */
  .prose {
    max-width: 34em;
  }
  .lede {
    margin-top: var(--space-4);
    font-size: var(--text-title);
    line-height: 1.5;
    color: var(--muted);
  }
  h2 {
    margin: var(--space-8) 0 var(--space-3);
  }
  /* The care notice stands before the passages: a block on --surface in Body 17. */
  .care {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .circles {
    margin-top: var(--space-7);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .circles h2 {
    margin: 0 0 var(--space-2);
  }
  .circles .button {
    margin-top: var(--space-3);
  }
  .passages,
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Passages as rows: the reference in Body 17/600 --link, the reason in Body 17. */
  .passages {
    background: var(--surface);
    border-radius: var(--radius-lg);
  }
  .passages li {
    padding: var(--space-3) var(--space-5);
  }
  .passages li + li {
    border-top: 1px solid var(--line);
  }
  .passages h3 {
    margin: 0;
    font-size: var(--text-body);
  }
  .passages h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .passages p {
    margin: 0;
  }
  .passages .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  .foot {
    margin: var(--space-3) 0 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  .list {
    margin-top: var(--space-7);
  }
  .tile {
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .list h2 {
    margin: 0;
    font-size: var(--text-title);
  }
  .list p {
    margin-bottom: 0;
  }
</style>
