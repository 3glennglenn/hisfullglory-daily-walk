---
// The AI layer: always its own block, always labelled, never inside the sourced note.
// Shows a chapter's own explanation, or the explanation of the book as a whole.
// The AI treatment of UI-SPEC 5.3: a block on --surface with a 1.5px dashed --ai frame, the sparkle
// icon, the heading "AI explanation" with the "AI" badge, its label in --ai, the interface face.
import { shopUrl } from "../config";
import {
  blocks,
  publicDomainTranslations,
  sectionTitles,
  type AiExplanation,
} from "../lib/ai";
import type { BibleBook } from "../lib/bible";
import AiBadge from "./AiBadge.astro";

interface Props {
  explanation: AiExplanation;
  book: BibleBook;
  /** The level of the block's heading: 2 on a page of its own, 3 inside "Around ...". */
  level?: 2 | 3;
}

const { explanation, book, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const Sub = `h${level + 1}` as "h3" | "h4";
const verses = explanation.chapter ? book.chapters[explanation.chapter - 1].verses : [];
const subject =
  explanation.scope === "book"
    ? `About ${book.name} as a whole`
    : `${book.name} ${explanation.chapter}`;
const label = `${subject} · Written by an AI model · ${
  explanation.review === "reviewed"
    ? "Reviewed by a theological reader"
    : "Not reviewed by a theological reader"
}`;
const written = new Date(`${explanation.written}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<section class="ai" data-layer="ai">
  <Heading>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z" />
    </svg>
    <span>AI explanation</span>
    <AiBadge />
  </Heading>
  <p class="label">{label}</p>
  <p class="foot">
    This explanation was written by an AI model to help you get started. It
    names no sources and can contain mistakes. Scripture comes first, and
    context with sources is shown separately on this page.
  </p>

  {
    explanation.sections.map((section) => (
      <>
        <Sub>{sectionTitles[explanation.scope][section.kind]}</Sub>
        {blocks(section.text).map((block) =>
          "list" in block ? (
            <ul>
              {block.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>{block.paragraph}</p>
          ),
        )}
      </>
    ))
  }

  {
    explanation.translations.length > 0 && (
      <>
        <Sub>How translations differ</Sub>
        <p class="foot">
          Compared with public-domain translations only.
        </p>
        {explanation.translations.map((entry) => (
          <div class="compare">
            <p class="ref">
              <a href={`#v${entry.verse}`}>Verse {entry.verse}</a>
            </p>
            <dl>
              <dt>World English Bible</dt>
              <dd>{verses.find((v) => v.number === entry.verse)?.text}</dd>
              {entry.renderings.map((rendering) => (
                <>
                  <dt>{publicDomainTranslations[rendering.translation]}</dt>
                  <dd>{rendering.text}</dd>
                </>
              ))}
            </dl>
            <p>{entry.note}</p>
          </div>
        ))}
      </>
    )
  }

  <details>
    <summary>About this explanation</summary>
    <p class="foot">
      Written by {explanation.model}, an AI model, on {written}. It draws on
      the WEB text and general knowledge and was not checked against sources
      by a person. Every quotation from Scripture is checked automatically
      against the WEB text.
    </p>
    <p class="foot">
      <a href={`${shopUrl}/pages/contact`}>Report a mistake</a>
    </p>
  </details>
</section>

<style>
  .ai {
    max-width: 34em;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1.5px dashed var(--ai);
    border-radius: var(--radius-md);
  }
  .ai > :global(h2),
  .ai > :global(h3) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--ai);
  }
  .icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .label {
    margin: var(--space-2) 0 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--ai);
  }
  .foot {
    margin: var(--space-2) 0 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  .ai > :global(h3),
  .ai > :global(h4) {
    margin-top: var(--space-5);
  }
  .ai > :global(h4) {
    font-size: var(--text-body);
  }
  ul {
    margin: var(--space-2) 0;
    padding-left: 1.2em;
  }
  li + li {
    margin-top: var(--space-2);
  }
  .compare {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .ref {
    margin: 0;
  }
  .ref a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  dl {
    margin: 0 0 var(--space-2);
  }
  dt {
    margin-top: var(--space-2);
    font-size: var(--text-footnote);
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
  }
  details {
    margin-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
    cursor: pointer;
  }
  details a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
