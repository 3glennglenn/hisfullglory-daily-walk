---
// The AI layer: always its own block, always labelled, never inside the sourced note.
// Shows a chapter's own explanation, or the explanation of the book as a whole.
import { shopUrl } from "../config";
import {
  blocks,
  publicDomainTranslations,
  sectionTitles,
  type AiExplanation,
} from "../lib/ai";
import type { BibleBook } from "../lib/bible";

interface Props {
  explanation: AiExplanation;
  book: BibleBook;
}

const { explanation, book } = Astro.props;
const verses = explanation.chapter ? book.chapters[explanation.chapter - 1].verses : [];
const subject =
  explanation.scope === "book"
    ? `About ${book.name} as a whole`
    : `${book.name} ${explanation.chapter}`;
const label = `${subject} · Written by an AI model · ${
  explanation.review === "reviewed"
    ? "Reviewed by a theological reader"
    : "Not reviewed by a theological reader"
}`;
const written = new Date(`${explanation.written}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<section class="card ai" data-layer="ai">
  <h2>AI explanation <span class="pill">AI</span></h2>
  <p class="eyebrow">{label}</p>
  <p class="small muted">
    This explanation was written by an AI model to help you get started. It
    names no sources and can contain mistakes. Scripture comes first, and
    context with sources is shown separately on this page.
  </p>

  {
    explanation.sections.map((section) => (
      <>
        <h3>{sectionTitles[explanation.scope][section.kind]}</h3>
        {blocks(section.text).map((block) =>
          "list" in block ? (
            <ul>
              {block.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>{block.paragraph}</p>
          ),
        )}
      </>
    ))
  }

  {
    explanation.translations.length > 0 && (
      <>
        <h3>How translations differ</h3>
        <p class="small muted">
          Compared with public-domain translations only.
        </p>
        {explanation.translations.map((entry) => (
          <div class="compare">
            <p class="ref">
              <a href={`#v${entry.verse}`}>Verse {entry.verse}</a>
            </p>
            <dl>
              <dt>World English Bible</dt>
              <dd>{verses.find((v) => v.number === entry.verse)?.text}</dd>
              {entry.renderings.map((rendering) => (
                <>
                  <dt>{publicDomainTranslations[rendering.translation]}</dt>
                  <dd>{rendering.text}</dd>
                </>
              ))}
            </dl>
            <p>{entry.note}</p>
          </div>
        ))}
      </>
    )
  }

  <details>
    <summary>About this explanation</summary>
    <p class="small muted">
      Written by {explanation.model}, an AI model, on {written}. It draws on
      the WEB text and general knowledge and was not checked against sources
      by a person. Every quotation from Scripture is checked automatically
      against the WEB text.
    </p>
    <p class="small">
      <a href={`${shopUrl}/pages/contact`}>Report a mistake</a>
    </p>
  </details>
</section>

<style>
  .ai {
    max-width: 42rem;
    border-style: dashed;
    background: var(--bg);
  }
  .pill {
    display: inline-block;
    vertical-align: middle;
    margin-left: 6px;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .eyebrow {
    margin-top: 6px;
  }
  h3 {
    margin-top: 22px;
  }
  ul {
    margin: 8px 0;
    padding-left: 1.2rem;
  }
  li + li {
    margin-top: 6px;
  }
  .compare {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .ref {
    margin: 0;
  }
  .ref a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  dl {
    margin: 0 0 8px;
  }
  dt {
    margin-top: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
  }
  details {
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 600;
    cursor: pointer;
  }
  details a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
