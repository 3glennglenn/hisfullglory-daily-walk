---
// Footer (UI-SPEC 8.3): the name, "Jesus at the Center" (the tagline's one place on the site),
// the positioning line, the footer links, the Appearance group, the WEB line and the copyright.
import { footerNav, site } from "../config";
import ThemeSwitch from "./ThemeSwitch.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="tagline">{site.tagline}</p>
      <p class="muted">{site.positioning}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {
          footerNav.map((item) => (
            <li>
              {item.ready ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span class="pending">{item.label}</span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap footer-small">
    <ThemeSwitch />
    <p>
      Scripture quotations are from the World English Bible (WEB), which is in
      the public domain.
    </p>
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: var(--space-7) var(--space-6);
    margin-top: var(--space-7);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-5);
  }
  .footer-name {
    font-size: var(--text-body);
    font-weight: 600;
    margin: 0;
  }
  .tagline {
    margin: 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  .footer-grid .muted {
    margin-top: var(--space-2);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    margin: 0 0 0 calc(-1 * var(--space-3));
    padding: 0;
  }
  a,
  .pending {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    font-size: var(--text-body);
  }
  a {
    color: var(--ink);
  }
  .pending {
    color: var(--muted);
  }
  .footer-small {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  .footer-small p {
    margin: var(--space-1) 0;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
