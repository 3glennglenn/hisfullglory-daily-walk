---
import { footerNav, site } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="muted">{site.positioning}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {
          footerNav.map((item) => (
            <li>
              {item.ready ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span class="pending">{item.label}</span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap footer-small">
    <!-- Shown by the script below; without JavaScript the page follows the device. -->
    <div class="theme" role="group" aria-label="Color theme" hidden>
      <span>Theme</span>
      <button type="button" data-theme-choice="auto" aria-pressed="true">Auto</button>
      <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
    </div>
    <p>
      Scripture quotations are from the World English Bible (WEB), which is in
      the public domain.
    </p>
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<script is:inline>
  // Light, Dark or Auto (follow the device). The choice is kept on this device only.
  (function () {
    var root = document.documentElement;
    var group = document.querySelector(".theme");
    var buttons = document.querySelectorAll("[data-theme-choice]");
    function show() {
      var current = root.dataset.theme || "auto";
      buttons.forEach(function (button) {
        button.setAttribute("aria-pressed", String(button.dataset.themeChoice === current));
      });
    }
    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        var choice = button.dataset.themeChoice;
        if (choice === "auto") delete root.dataset.theme;
        else root.dataset.theme = choice;
        try {
          if (choice === "auto") localStorage.removeItem("hfg-theme");
          else localStorage.setItem("hfg-theme", choice);
        } catch (error) {}
        show();
      });
    });
    show();
    if (group) group.hidden = false;
  })();
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--paper);
    padding-block: 36px 28px;
    margin-top: 40px;
  }
  .footer-grid {
    display: grid;
    gap: 20px;
  }
  .footer-name {
    font-size: 1.2rem;
    margin-bottom: 0;
  }
  .footer-grid .muted {
    margin-top: 4px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    list-style: none;
    margin: 0 0 0 -10px;
    padding: 0;
  }
  a,
  .pending {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-size: 0.95rem;
  }
  a {
    color: var(--ink);
  }
  .pending {
    color: var(--muted);
  }
  .footer-small {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .footer-small p {
    margin: 4px 0;
  }
  .theme {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .theme[hidden] {
    display: none;
  }
  .theme button {
    min-height: 44px;
    min-width: 64px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .theme button[aria-pressed="true"] {
    border-color: var(--strong);
    font-weight: 600;
  }
  @media (min-width: 52rem) {
    .footer-grid {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
