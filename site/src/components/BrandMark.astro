---
// The cross from the app icon (public/icon.svg), drawn with theme tokens so it works in Light and Dark.
---

<svg
  class="brand-mark"
  viewBox="0 0 48 48"
  width="40"
  height="40"
  aria-hidden="true"
  focusable="false"
>
  <rect x="1" y="1" width="46" height="46" rx="11"></rect>
  <path d="M24 11v26M15 19.5h18"></path>
</svg>

<style>
  .brand-mark {
    flex: none;
  }
  rect {
    fill: var(--paper);
    stroke: var(--border);
  }
  path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
  }
</style>
