---
// The label at the top of a context check that an AI model wrote and no person has checked
// (review "ai-unreviewed", src/lib/content.ts). The words carry the meaning, not the colour.
import { aiUnreviewedLabel } from "../lib/content";
---

<p class="ai-unreviewed" role="note">{aiUnreviewedLabel}</p>

<style>
  .ai-unreviewed {
    display: inline-block;
    margin: 0 0 16px;
    padding: 8px 14px;
    border: 1px solid var(--strong);
    /* Not the full pill of the draft banner: this text wraps to several lines on a phone. */
    border-radius: 12px;
    font-size: 0.86rem;
    color: var(--strong);
  }
</style>
