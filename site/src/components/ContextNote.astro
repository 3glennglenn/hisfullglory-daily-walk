---
// Shows one sourced note the way the app's Context tab does, or the honest fallback.
// Labels and wording follow src/bible/Reader.tsx. The sourced treatment of UI-SPEC 5.3: a block on
// --surface with a 1px solid --line edge, the document icon, the heading and a review pill; the
// words (heading, review pill, "Why we say this") carry the layer, never the colour alone.
import { scopeLabel } from "../../../src/bible/knowledge.ts";
import { basisLink, type KnowledgeRecord } from "../lib/bible";

interface Props {
  note?: KnowledgeRecord;
  /** What the note is about, for example "Psalms" or "Psalms 23". */
  subject: string;
  /** The level of the block's heading: 2 on a page of its own, 3 inside "Around ...". */
  level?: 2 | 3;
}

const { note, subject, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const Sub = `h${level + 1}` as "h3" | "h4";
const status = !note
  ? ""
  : note.review === "reviewed"
    ? "Reviewed"
    : note.review === "editorial draft"
      ? "Editorial draft"
      : "Editorial observation";
const listed = note?.sources ?? [];
const sources =
  note && !listed.some((source) => source.url === note.source)
    ? [{ title: "Primary source", url: note.source }, ...listed]
    : listed;
---

<section class="note" data-layer="sourced">
  {
    note ? (
      <>
        <Heading>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
            <path d="M14 2v4a2 2 0 0 0 2 2h4M10 9H8M16 13H8M16 17H8" />
          </svg>
          <span>{scopeLabel[note.scope]}</span>
        </Heading>
        <p class="meta">
          <span>{subject}</span>
          <span class="pill">{status}</span>
        </p>
        <p class="note-text">{note.text}</p>
        <details>
          <summary>Why we say this</summary>
          <p class="foot">
            {note.editor} · {note.interpretiveStatus}
            {note.review === "editorial draft" &&
              " · not yet reviewed by a theological reader"}
          </p>
          {note.basis && note.basis.length > 0 && (
            <>
              <Sub>From the text itself</Sub>
              <ul>
                {note.basis.map(basisLink).map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </>
          )}
          <Sub>Sources</Sub>
          <ul>
            {sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer">
                  {source.title}
                </a>
              </li>
            ))}
          </ul>
          <p class="foot">
            Notes summarise their sources in our own words. Where Christians or
            scholars disagree, the note says so. Notes are not original-language
            evidence and do not replace the text.
          </p>
        </details>
      </>
    ) : (
      <>
        <Heading>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
            <path d="M14 2v4a2 2 0 0 0 2 2h4M10 9H8M16 13H8M16 17H8" />
          </svg>
          <span>Context</span>
        </Heading>
        <p>
          Context for this book is being written. A note appears here only
          once it names its sources.
        </p>
      </>
    )
  }
</section>

<style>
  .note {
    max-width: 34em;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .note > :global(h2),
  .note > :global(h3) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }
  .icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  .pill {
    padding: 0 var(--space-2);
    border: 1px solid var(--muted);
    border-radius: var(--radius-xs);
    font-weight: 600;
  }
  .note-text {
    margin: var(--space-3) 0 0;
  }
  .foot {
    margin: var(--space-2) 0 0;
    font-size: var(--text-footnote);
    line-height: 1.38;
    color: var(--muted);
  }
  details {
    margin-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
    cursor: pointer;
  }
  details > :global(h3),
  details > :global(h4) {
    margin-top: var(--space-3);
    font-size: var(--text-body);
  }
  ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.2em;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
