---
// Says plainly how an editorial page was made and how far it has been checked.
import { editorialNote, type Review } from "../lib/content";

interface Props {
  review: Review;
  drafted: "ai" | "human";
}

const { review, drafted } = Astro.props;
const note = editorialNote(review, drafted);
---

<p class="small muted editorial" data-layer="editorial">{note}</p>

<style>
  .editorial {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    max-width: 42rem;
  }
</style>
