---
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-600.css";
import "../styles/tokens.generated.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name}: study the Bible together`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// One share image for every page (public/og.png, made by scripts/og-image.mjs).
const shareImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F3F1EE" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title ?? pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content={`${site.name}: study the Bible together`}
          />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <script is:inline>
      /* First paint (UI-SPEC 3.3). Same keys, order and theme-color pairs as index.html of the
         app, so the site and the app open in the same look. It runs before the stylesheet
         paints; the reader's choice from the footer switch is applied here, without a flash.
         The old keys are only read here; ThemeSwitch writes hfg-lamplight and removes them. */
      (() => {
        const legacy = () => {
          let old = localStorage.getItem("hfg-appearance") || localStorage.getItem("hfg-theme");
          if (!old) old = JSON.parse(localStorage.getItem("hfg-daily-walk:v3") || "null")?.theme;
          return old === "dark" ? "on" : old === "light" ? "off" : "auto";
        };
        let look = "cover", lamp = "auto";
        try {
          look = localStorage.getItem("hfg-look") === "marked" ? "marked" : "cover";
          lamp = localStorage.getItem("hfg-lamplight") || legacy();
        } catch { /* storage blocked or unreadable JSON: defaults */ }
        const dark = lamp === "on" || (lamp !== "off" && matchMedia("(prefers-color-scheme: dark)").matches);
        const root = document.documentElement;
        root.dataset.look = look;
        root.dataset.mode = dark ? "lamplight" : "light";
        const color = { cover: ["#F3F1EE", "#1A120E"], marked: ["#FFFDF9", "#1A120E"] }[look][dark ? 1 : 0];
        document.querySelector("meta[name=theme-color]")?.setAttribute("content", color);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
